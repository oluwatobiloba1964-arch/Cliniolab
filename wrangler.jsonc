{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cliniolab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cliniolab",
      "database_id": "c69a92d3-14f6-44f2-b4e1-03930a5cd339"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cliniolab-upload"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cliniolab-upload"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://cliniolab.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://mppdjbkrmzptyxzygjjl.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1wcGRqYmtybXpwdHl4enlnampsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM4NjE4MDUsImV4cCI6MjA5OTQzNzgwNX0.BijpuW6uUMqo7_4qpieZahqjImYdBjWu3PUDOEC52ZA",
  
    "D1_ACCOUNT_ID": "8045513c93d1b4cdb761ce87f0a10bb7"
  }
}
